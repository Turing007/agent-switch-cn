{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-switch-cn",
  "version": "0.1.0",
  "identifier": "cn.agentswitch.app",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "agent-switch-cn",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon-256.png",
      "icons/icon-64.png",
      "icons/icon-32.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
